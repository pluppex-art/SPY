# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your_gemini_api_key_here"

# Revenue Intelligence Engine — frontend keys (VITE_ prefix required for Vite)
VITE_GEMINI_API_KEY="your_gemini_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"

# SUPABASE: configure your Supabase project here for data persistence.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_xxxx"
# service_role — SECRETA, só no backend, nunca vai para o browser. NÃO commitar o valor real.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxx"

# SPY PUBLIC API — chaves de autenticação para o endpoint /api/v1/leads
# Envie no header: x-api-key: <chave>
# FORMATO OBRIGATÓRIO: "chave1:tenantIdA,chave2:tenantIdB" — cada chave é vinculada
# a exatamente UM tenant (o servidor usa esse tenantId, nunca o do corpo da
# requisição). Uma entrada sem ":tenantId" é ignorada silenciosamente pelo parser
# (fica de fora do mapa válido) — confira o log de startup do servidor
# ("[API Keys] N chave(s) válida(s) carregada(s)") para confirmar que carregou.
# Nomes novos (SPY_*) com fallback pros antigos (AXIS_*) no código — produção na
# Vercel ainda só tem as AXIS_* configuradas até a migração manual.
SPY_API_KEYS="your_spy_api_key_main_here:tenant-uuid-aqui,your_spy_api_key_form_here:outro-tenant-uuid-aqui"

# SPY_CORS_ORIGIN — lista de origens permitidas pra chamar a API, separadas por
# vírgula (ex: "https://seudominio.com,http://localhost:5173"). Sem essa variável,
# nenhuma origem é liberada — NÃO usar "*" em produção.
# SPY_FORM_TENANT_ID — tenant que recebe os leads do formulário público do
# site de marketing (InteractiveForm.tsx, rota /f/:niche). Usado por
# POST /api/public/lead-capture. Sem essa variável, o formulário público
# mostra erro em vez de fingir sucesso.
SPY_FORM_TENANT_ID="<uuid-do-tenant-no-supabase>"
SPY_FORM_CLIENT_ID="<id-do-cliente-na-tabela-clientes>"
SPY_CORS_ORIGIN="https://seudominio.com,http://localhost:5173"

# AURORA_WEBHOOK_URL — URL do webhook de chat da Aurora (workflow AURORA CORE no n8n).
# Só o backend (server.ts) chama essa URL, nunca o navegador. Usada por POST /api/ai/aurora-chat.
AURORA_WEBHOOK_URL="https://your-n8n-instance/webhook/your-webhook-id/chat"

# REDIS_URL — Redis-SPY (cache/aceleração, nunca fonte de verdade; ver
# server/redisClient.ts). SEM essa variável o servidor funciona normalmente,
# só sem cache (100% Supabase). O backend roda na Vercel — um host "interno"
# de um provedor tipo EasyPanel (ex.: automacao-target_spyredis) NÃO é
# alcançável daqui; precisa ser o endpoint EXTERNO desse Redis, com TLS.
# Formato esperado (TLS): "rediss://default:<senha>@<host-publico>:<porta>"
# Se o proxy não fizer TLS termination, usar "redis://" (sem o "s") — mas
# nesse caso o tráfego entre Vercel e o Redis não é criptografado, evitar.
# NUNCA commitar o valor real aqui — configurar direto nas env vars da Vercel.
REDIS_URL="rediss://default:sua_senha_aqui@seu-redis-publico.exemplo.com:6379"

# GOOGLE CALENDAR — integração server-side (server/googleCalendar.ts). Requer um
# OAuth Client ID do tipo "Web application" no Google Cloud Console, com esta URL
# cadastrada em "Authorized redirect URIs": <sua-origem>/api/google-calendar/oauth/callback
GOOGLE_CLIENT_ID="mesmo-valor-de-VITE_GOOGLE_CLIENT_ID-se-for-o-mesmo-client"
# SECRETA — nunca prefixar com VITE_, nunca vai para o browser. Gerada no
# Google Cloud Console, na tela de credenciais do OAuth Client acima.
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_OAUTH_REDIRECT_URI="https://seudominio.com/api/google-calendar/oauth/callback"
# Origem pra onde o usuário volta depois de autorizar (sem barra no final).
# Sem essa variável, cai em "/agenda" relativo (funciona só se front e API
# estiverem na mesma origem).
GOOGLE_OAUTH_SUCCESS_ORIGIN="https://seudominio.com"
# SECRETA — chave de assinatura HMAC do parâmetro state do OAuth. Sem essa
# variável, cai em SUPABASE_SERVICE_ROLE_KEY (funciona, mas prefira uma
# própria pra poder rotacionar sem afetar o acesso ao banco).
GOOGLE_OAUTH_STATE_SECRET="uma_string_aleatoria_longa_gerada_so_pra_isso"

# TABLE_COMPARISON_AI_WEBHOOK_URL: webhook do n8n que roda a IA (Aurora) da Comparação de Tabelas (Clínicas e Saúde).
# É um segredo (caminho imprevisível). Sem ele, "Analisar pendências com a Aurora" responde 503.
TABLE_COMPARISON_AI_WEBHOOK_URL="https://SEU-N8N/webhook/spy-comparacao-xxxxxxxx"

# N8N_INTERNAL_KEY — SECRETA. Só o n8n (AURORA CORE) usa, no header x-internal-key, pra pedir um
# link de relatório em PDF (ver server/financialReportPdf.ts). Nunca vai para o browser nem para
# nenhum tenant. Sem ela, a rota de criar link responde 503.
N8N_INTERNAL_KEY="uma_string_aleatoria_longa_so_pro_n8n"
# REPORT_LINK_SECRET — SECRETA, assina o link de download do relatório em PDF (HMAC + expiração de
# 30min). Sem essa variável, cai em SUPABASE_SERVICE_ROLE_KEY (funciona, mas prefira uma própria).
REPORT_LINK_SECRET="uma_string_aleatoria_longa_gerada_so_pra_isso"

# Gatilhos de mensagem em linguagem natural (server/messageTriggers.ts) — interpretação (IA monta
# lista de leads + mensagem) e execução (Júlia manda de verdade, só depois de aprovado) rodam em
# dois webhooks do n8n. São segredos (caminho imprevisível). Sem eles, as rotas respondem 503.
N8N_INTERPRETAR_GATILHO_WEBHOOK_URL="https://SEU-N8N/webhook/interpretar-gatilho-mensagem"
N8N_EXECUTAR_GATILHO_WEBHOOK_URL="https://SEU-N8N/webhook/executar-gatilho-mensagem"
# N8N_AGENT_WEBHOOK_KEY — SECRETA, vai no header x-internal-key das duas chamadas acima. É a MESMA
# credencial "SPY - Internal Report Key" já usada pelos ~35 agentes com gatilho direto (sem Aurora)
# no n8n — mesmo segredo pendente de confirmação de valor com o Gustavo, não é um novo bloqueio.
N8N_AGENT_WEBHOOK_KEY="uma_string_aleatoria_longa_so_pro_n8n"

# "Ver fluxo" ao vivo (server/agentFlow.ts, GET /api/agent-flow/:agentKey) — busca o workflow
# REAL na instância n8n via n8n Public API, em vez de só mostrar o snapshot estático congelado em
# src/pages/settings/sections/agentFlowDiagrams.ts. Sem estas duas variáveis, a rota responde 503
# e o frontend cai automaticamente pro snapshot estático — sem crash, sem UI quebrada.
# N8N_API_URL — base da API pública da instância n8n (ex: "https://automacao-target-n8n.vr4mar.easypanel.host/api/v1").
N8N_API_URL="https://SEU-N8N/api/v1"
# N8N_API_KEY — SECRETA. Gerada pelo dono da conta DENTRO do próprio n8n, em Settings → n8n API →
# Create an API Key. Escopo somente-leitura já é suficiente — esta feature só faz GET.
N8N_API_KEY="uma_api_key_gerada_no_proprio_n8n"
